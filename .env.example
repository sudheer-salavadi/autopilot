# PostgreSQL
POSTGRES_USER=autopilot
POSTGRES_PASSWORD=autopilot_password
POSTGRES_DB=autopilot

# Database URL (used by backend service)
DATABASE_URL=postgresql+asyncpg://autopilot:autopilot_password@db:5432/autopilot

# WorkOS
WORKOS_API_KEY=sk_...
WORKOS_CLIENT_ID=client_...
WORKOS_COOKIE_PASSWORD=at_least_32_characters_long_secret_here__

# FastAPI session secret — openssl rand -hex 32
SESSION_SECRET_KEY=your_session_secret_key_here

# Fernet encryption key for webhook secrets
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_key_here

# AI for demo data generation
# Option 1 — OpenAI
OPENAI_API_KEY=sk-...
# Option 2 — LM Studio (takes priority when set)
# LM_STUDIO_URL=http://192.168.1.50:1234/v1
# LM_STUDIO_MODEL=your-model-name-from-lm-studio


# GitHub App (optional — register at github.com/settings/apps/new)
# Callback URL:  {FRONTEND_URL}/github/callback
# Webhook URL:   {BACKEND_URL}/api/webhooks/github-app
# Permissions:   Issues → Read & Write, Metadata → Read
# Events:        Issues, Installation
GITHUB_APP_ID= # Client ID shown on GitHub App settings page
GITHUB_APP_PRIVATE_KEY=   # full PEM with \n-escaped newlines
GITHUB_APP_WEBHOOK_SECRET= 
GITHUB_APP_SLUG=          # slug shown in github.com/apps/{slug}
NEXT_PUBLIC_GITHUB_APP_SLUG=   # same value, exposed to frontend

# For Github HTTPS Webhook: cloudflared tunnel --url http://localhost:8000

# URLs
FRONTEND_URL=http://localhost:3000
INTERNAL_API_URL=http://backend:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:8000/api/auth/callback
