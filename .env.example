# ── Quick start — skip auth entirely (evaluation only) ───────────────────────
# Uncomment the line below, then run:
#   docker compose up && docker compose exec backend alembic upgrade head
# A "Dev User" is created automatically. NEVER enable this in production.
# SKIP_AUTH=true

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=autopilot
POSTGRES_PASSWORD=autopilot_password
POSTGRES_DB=autopilot

# Set automatically by docker-compose from the vars above — leave as-is
DATABASE_URL=postgresql+asyncpg://autopilot:autopilot_password@db:5432/autopilot

# ── Authentication ────────────────────────────────────────────────────────────
# Auth is built in: email + password, bcrypt-hashed, JWT session cookie.
# No external identity provider, nothing else to sign up for.
#
# Not needed when SKIP_AUTH=true — insecure dev defaults are used automatically.
# Required for real use (SKIP_AUTH=false). Generate both values:
#   SESSION_SECRET_KEY:  openssl rand -hex 32
#   ENCRYPTION_KEY:      python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SESSION_SECRET_KEY=
# ENCRYPTION_KEY=

# Block new registrations once your team has signed up (existing accounts
# keep working). Default: signups open.
# DISABLE_SIGNUP=true

# ── AI — bring your own model ─────────────────────────────────────────────────
# AI_BASE_URL points at ANY OpenAI-compatible endpoint (LM Studio, Ollama, vLLM,
# OpenRouter, ...) and is used for clustering, scoring, and Ask AI — same code
# path as production, not a Simulate-only shortcut. Takes priority over
# OPENAI_API_KEY below when set.
# AI_BASE_URL=http://host.docker.internal:11434/v1   # Ollama example
# AI_MODEL=llama3.1                                   # ollama pull llama3.1 first
# AI_API_KEY=            # optional — most local servers ignore it

# OpenAI — zero-config default used when AI_BASE_URL is not set. Not a hard
# requirement; only needed if you're not pointing at a local/other model above.
OPENAI_API_KEY=sk-...

# Gemini — optional failure fallback, used only when the primary call errors
# (rate limits, outage). Never the primary path.
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.0-flash

# Embeddings — defaults to OpenAI's text-embedding-3-small (1536 dims) via
# OPENAI_API_KEY, or AI_BASE_URL above if it serves an embeddings model.
# AI_EMBEDDING_DIMS must match your chosen model's output dimension and sizes
# the DB's vector column at migration time — set before first `alembic upgrade`.
# AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_EMBEDDING_DIMS=1536

# ── GitHub App (optional) ─────────────────────────────────────────────────────
# Register at github.com/settings/apps/new
#   Callback URL:  {FRONTEND_URL}/github/callback
#   Webhook URL:   {BACKEND_URL}/api/webhooks/github-app
#   Permissions:   Issues → Read & Write, Metadata → Read
#   Events:        Issues, Installation
# GITHUB_APP_ID=              # Client ID from GitHub App settings
# GITHUB_APP_PRIVATE_KEY=     # full PEM with \n-escaped newlines
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_APP_SLUG=            # slug from github.com/apps/{slug}
# NEXT_PUBLIC_GITHUB_APP_SLUG=  # same value, exposed to frontend

# To receive GitHub webhooks locally: cloudflared tunnel --url http://localhost:8000

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
INTERNAL_API_URL=http://backend:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
